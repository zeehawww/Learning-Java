class Solution {
    public int removeDuplicates(int[] nums) {

        // If the array is empty, there are no unique elements.
        if (nums.length == 0) {
            return 0;
        }

        int write = 1;

        for (int read = 1; read < nums.length; read++) {

            // Found a new unique element
            if (nums[read] != nums[read - 1]) {

                nums[write] = nums[read];
                write++;
            }
        }

        return write;
    }
}
