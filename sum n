
import java.util.*;

class Main{
    public static void main(String[] args){

        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int i = 0;
        int sum = 0; //0, 1, 3, 6, 10

        for(i = 0; i <= n; i++){
            sum += i; // sum = sum + i ( 0 + 1 = 1; 1+2 = 3, 3+3 = 6, 6+4 = 10, loop ends)
            System.out.println(sum);
        }




    }
}
